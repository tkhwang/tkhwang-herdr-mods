 //
 // Modified from Herdr's shipped `files` mod (https://github.com/herdrdev/herdr-app, Apache-2.0):
 // added DIR, icon() and the Material Icon Theme icons in the rows and the preview header.
+//
+// Changed from LaiqianDS/herdr-mods@eae0b91: a click on a Markdown file shows it in the space's
+// Markdown tab in the center (tkhwang-markdown, on View) instead of the read-only preview here, its
+// row lit while that tab shows it, and the folder stays put while that tab is the shown one (marked
+// "markdown tab", with markdown.js).
 import { View, div, svg, image } from "gpui-kit";
 import { v_flex, h_flex, Editor, EditorState } from "gpui-base";
 import { spaces, panes, focused, exec, readTextFile, watchFolder, theme, settings, window } from "herdr";
 import { icon } from "./lookup.js";
+import { MARKDOWN, markdownTab, markdownShown, showMarkdown } from "./markdown.js"; // markdown tab
 
 function location() {
   const space = spaces().find(s => s.active), f = focused();
   const pane = f?.pane ? panes().find(p => p.pane === f.pane) : null;
   const on = f?.pane === null ? (f.terminal?.includes("/") ? f.terminal.split("/")[0] : null) : space?.machine ?? null;
+  // markdown tab: the Markdown tab has no terminal; keep showing the folder its file was opened from.
+  const md = markdownTab(space?.id);
+  if (md?.cwd && !pane?.cwd && md.tab === space?.tabs?.find(t => t.active)?.id) return { cwd: md.cwd, on: md.on ?? null };
   return { cwd: pane?.cwd || f?.cwd || space?.folder, on };
 }
 const key = () => JSON.stringify(location());
