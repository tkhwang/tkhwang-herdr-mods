diff --git b/views/view-switch.js b/views/view-switch.js
new file mode 100644
index 0000000..b6be444
--- /dev/null
+++ b/views/view-switch.js
@@ -0,0 +1,49 @@
+// view mode: the [1] | [1|2] | [1|2/3] window switch, between + and the panel buttons. Each button
+// is a little picture of the shown tab's windows, numbered as the folder bar numbers them: 1 the
+// main window alone, 2 the secondary window beside it, 3 another under 2. tkhwang-view-mode (an
+// empty 0px block in the layout) does the work: a click sends it the mode, and the lit button is
+// the mode it keeps in the shared "tkhwang-view-mode.view".
+import { div } from "gpui-kit";
+import { h_flex, v_flex } from "gpui-base";
+import { theme, shared, run } from "herdr";
+
+const VIEW = "tkhwang-view-mode.view";
+// columns: left to right, each a window's digit, or a list of digits for windows stacked in it.
+const CHOICES = [
+  { id: "view-mobile", mode: "mobile", command: "tkhwang-view-mode.1", columns: ["1"], label: "1: the main window alone" },
+  { id: "view-desktop", mode: "desktop", command: "tkhwang-view-mode.2", columns: ["1", "2"], label: "2: the main and secondary windows side by side (a tab with one window gets a second; a third is put away, still running)" },
+  { id: "view-triple", mode: "triple", command: "tkhwang-view-mode.3", columns: ["1", ["2", "3"]], label: "3: the main window, and two windows stacked on its right (the third 2 put away comes back; a tab with fewer gets them)" },
+];
+
+export const viewSwitchMethods = {
+  viewSwitch() {
+    const t = theme(), value = shared(VIEW);
+    const mode = value === "mobile" || value === "triple" ? value : "desktop";
+    // The picture's lines take the digits' color, so hover is tracked here.
+    const choice = ({ id, mode: own, command, columns, label }) => {
+      const on = mode === own, hot = on || this.viewHover === id, ink = hot ? t.foreground : t.dim;
+      return div().id(id).h(24).px(5).flex_none().flex().items_center().justify_center().rounded(5)
+        .bg(on ? t.selected : hot ? t.hover : t.chrome).text_color(ink)
+        .tooltip(label).accessibility_label(label)
+        .on_hover((hovered, cx) => {
+          const next = hovered ? id : this.viewHover === id ? null : this.viewHover;
+          if (next !== this.viewHover) { this.viewHover = next; cx.notify(); }
+        })
+        .on_mouse_down("left", (_e, cx) => cx.stop_propagation())
+        .on_click((_e, cx) => {
+          cx.stop_propagation();
+          // A drag's release can leave a click behind; it must not also switch.
+          if (!(Date.now() < this.ignoreClickUntil)) run(command);
+        })
+        .child(h_flex().h(19).flex_none().rounded(3).border_1().border_color(ink).children(columns.map((column, i) => {
+          const cells = Array.isArray(column) ? column : [column], stacked = cells.length > 1;
+          return v_flex().w(columns.length === 1 ? 15 : 12).h_full().when(i > 0, (el) => el.border_l(1).border_color(ink))
+            .children(cells.map((digit, j) => div().w_full().flex_1().flex().items_center().justify_center().font_semibold()
+              .text_size(stacked ? 8 : 10).when(stacked, (el) => el.line_height("8px"))
+              .when(j > 0, (el) => el.border_t(1).border_color(ink)).child(digit)));
+        })));
+    };
+    return h_flex().id("view-mode").h(26).p(1).gap(1).flex_none().items_center().rounded(6)
+      .border_1().border_color(t.border).children(CHOICES.map(choice));
+  },
+};
