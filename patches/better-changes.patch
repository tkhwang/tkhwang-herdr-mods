+  return [
+    "Write a git commit message for the staged changes below.",
+    "Rules:",
+    "- Reply with the commit message only: no quotes, no code fence, no explanation.",
+    "- First a subject line of at most 72 characters, imperative mood, no trailing period.",
+    recent.length
+      ? "- Follow the form of these recent commits from this repository exactly: the same kind of prefix (the same type words, untranslated, and a scope in parentheses when they have one), a summary in their language, tone and grammatical form, and a body after one blank line only when they write bodies, in the same shape:\n" +
+        recent.map((m) => m.split("\n").map((l) => `  ${l}`).join("\n")).join("\n  ---\n")
+      : "- Use the Conventional Commits form, type(scope): summary, in English, with a short body after one blank line only when the change needs explaining.",
+    "- Say what the change does and why, not which files changed. Wrap body lines at 72 characters.",
+    "- Add no trailers or attribution: no Co-Authored-By, Signed-off-by or \"Generated with\" lines.",
+    branch ? `Branch: ${branch}` : null,
+    "Changed files:",
+    stat.trim() || "(none)",
+    cut ? `Staged diff (first ${AI_DIFF_LIMIT} characters):` : "Staged diff:",
+    diff.slice(0, AI_DIFF_LIMIT),
+  ]
+    .filter((line) => line !== null)
+    .join("\n");
+}
+
+// The model's answer as a commit message: code fences and a "Subject:" label dropped, quotes
+// around the subject removed, runs of blank lines folded to one. An AI attribution line below
+// the subject is dropped too, since Claude Code adds one by habit (marked `no ai trailer`): a
+// Co-Authored-By with an AI's own address (Claude's noreply@anthropic.com, OpenAI's, a
+// Copilot, Claude, Codex or Gemini GitHub account), or a line that starts with "Generated
+// with/by" an AI. A person's Co-Authored-By is matched by neither, whatever the name or domain.
+const AI_COAUTHOR =
+  /^co-authored-by:.*[\s<]((noreply|codex)@(anthropic|openai)\.com|(\d+\+)?(copilot|claude|codex|gemini)[\w-]*(\[bot\])?@users\.noreply\.github\.com)>?$/i;
+const AI_GENERATED = /^[^\p{L}\p{N}]*generated (with|by) \[?(claude|chatgpt|openai|codex|grok|gemini|copilot)\b/iu;
+const aiTrailer = (l) => AI_COAUTHOR.test(l.trim()) || AI_GENERATED.test(l.trim());
+
+export function aiMessage(text) {
+  let lines = String(text ?? "")
+    .replace(/\r/g, "")
+    .split("\n")
+    .map((l) => l.trimEnd())
+    .filter((l) => !l.trim().startsWith("```"));
+  const subject = lines.findIndex((l) => l.trim());
+  lines = lines.filter((l, i) => i <= subject || !aiTrailer(l));
+  while (lines.length && !lines[0].trim()) lines.shift();
+  if (lines.length)
+    lines[0] = lines[0]
+      .trim()
+      .replace(/^(subject|commit message)\s*:\s*/i, "")
+      .replace(/^["'`]+|["'`]+$/g, "")
+      .trim();
+  return lines
+    .join("\n")
+    .replace(/\n{3,}/g, "\n\n")
+    .trim();
+}
